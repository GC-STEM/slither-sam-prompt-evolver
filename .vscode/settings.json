{
  "files.encoding": "utf8",
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.rulers": [
    80,
    100
  ],
  "editor.minimap.enabled": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.guides.indentation": true,
  "breadcrumbs.enabled": true,
  "workbench.editorAssociations": {
    "README.md": "vscode.markdown.preview.editor",
    "00_overview.md": "vscode.markdown.preview.editor",
    "10_requirements.md": "vscode.markdown.preview.editor",
    "20_design.md": "vscode.markdown.preview.editor",
    "21_architecture.md": "vscode.markdown.preview.editor",
    "30_construction.md": "vscode.markdown.preview.editor",
    "40_testing.md": "vscode.markdown.preview.editor",
    "worksheet.md": "vscode.markdown.editor",
    "*.md": "vscode.markdown.editor",
    "*.markdown": "vscode.markdown.editor"
  },
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "search.exclude": {
    "**/.vscode": true,
    "**/.vscodeedu": true,
    "**/*.code-workspace": true
  },
  "files.exclude": {
    "**/.vscode": true,
    "**/.vscodeedu": true,
    "**/*.code-workspace": true
  },
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  },
  "python.terminal.executeInFileDir": true,
  "markdown.extension.completion.enabled": true,
  "markdown.extension.preview.autoShowPreviewToSide": true,
  "markdown.extension.toc.levels": "2..2",
  "markdown.extension.toc.orderedList": false,
  "markdown.extension.toc.omittedFromToc": {
    "*.md": [
      "## Table of Contents"
    ]
  },
  "cSpell.words": [
    "Brightspace",
    "hilow"
],
  "[json]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  },
  "[yaml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  },
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  }
}
